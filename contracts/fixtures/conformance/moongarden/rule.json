{
  "schemaVersion": 1,
  "domain": "moongarden.example",
  "version": 1,
  "chapterPage": {
    "url": "https://moongarden\\.example/read/(?<series>[a-z0-9-]+)/vol-[0-9]+/ch-(?<chapter>[0-9]+)(?:\\?[^#]*)?",
    "title": { "selector": "meta[property=\"og:title\"]", "attribute": "content", "pattern": "^(?<value>[^|]+)" },
    "chapterLabel": { "selector": "header .chapter-meta" },
    "images": { "selector": "figure.panel > img", "attributes": ["data-lazy-src", "src"] },
    "next": { "selector": "nav.chapters a[rel=next]" },
    "previous": { "selector": "nav.chapters a[rel=prev]" }
  },
  "seriesPage": {
    "url": "https://moongarden\\.example/read/(?<series>[a-z0-9-]+)/?",
    "title": { "selector": "h1.series-name" },
    "chapterLinks": "table.toc td:first-child > a"
  }
}
