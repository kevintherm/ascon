<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 11 and lower. Reading history stays on the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
